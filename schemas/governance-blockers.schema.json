{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/governance-blockers.schema.json",
  "title": "Hermes AgentOps Governance Blocker Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "blockers"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "taxonomy_id": {"type": "string", "const": "governance_blockers/v1"},
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "category", "meaning", "current_resolution"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,96}$"},
          "category": {"type": "string", "enum": ["approval", "lock", "audit", "command", "runtime", "stage"]},
          "meaning": {"type": "string", "minLength": 1},
          "current_resolution": {"type": "string", "enum": ["manual_review", "defer_next_stage", "fix_input", "separate_adr"]}
        }
      }
    }
  }
}
