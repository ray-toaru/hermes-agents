#!/usr/bin/env python3
"""Validate apply readiness evidence reports.

This checker is intentionally read-only. It validates aggregate evidence report
shape and consistency. It never authorizes apply, acquires locks, mutates
profiles/runtime state, reads secrets, executes rollback, or orchestrates
business tasks.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any

import jsonschema
import yaml

from agentops_common import load_yaml, load_json, sha256_file, agent_from_change_id, is_safe_relative_path

DEFAULT_ROOT = Path(__file__).resolve().parents[1]
REQUIRED_PRE_APPLY_GATES = {"change_verify", "approval_identity", "pre_apply_plan", "apply_lock_analysis"}

def validate_required_gate(gate: dict[str, Any], label: str, report_status: Any, errors: list[str]) -> None:
    if gate.get("phase") != "pre_apply":
        errors.append(f"{label}: required gate must be pre_apply phase")
    if gate.get("required_before_apply") is not True:
        errors.append(f"{label}: required gate must have required_before_apply true")
    if not isinstance(gate.get("evidence_sha256"), str):
        errors.append(f"{label}: required gate must have concrete evidence_sha256")

    gate_status = gate.get("status")
    blocking = gate.get("blocking")
    if report_status == "evidence_complete_not_authorized":
        if gate_status != "present":
            errors.append(f"{label}: required gate must be present")
        if blocking is not False:
            errors.append(f"{label}: required present gate must be non-blocking")
    elif report_status == "blocked":
        if gate_status == "present" and blocking is not False:
            errors.append(f"{label}: present required gate must be non-blocking")
        elif gate_status == "blocked" and blocking is not True:
            errors.append(f"{label}: blocked required gate must be blocking")
        elif gate_status not in {"present", "blocked"}:
            errors.append(f"{label}: required gate must be present or blocked in blocked reports")
    elif gate_status == "present" and blocking is not False:
        errors.append(f"{label}: present required gate must be non-blocking")

def validate_report(root: Path, report: Any, path: Path, validator: jsonschema.Draft202012Validator, *, require_evidence_files: bool) -> list[str]:
    errors: list[str] = []
    for error in sorted(validator.iter_errors(report), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{path}: {location}: {error.message}")
    if not isinstance(report, dict):
        return errors

    if report.get("mutation_enabled") is not False:
        errors.append(f"{path}: mutation_enabled must remain false")
    if report.get("apply_authorized") is not False:
        errors.append(f"{path}: apply_authorized must remain false")

    change_id = report.get("change_id")
    if isinstance(change_id, str):
        if report.get("readiness_report_id") != f"{change_id}_readiness":
            errors.append(f"{path}: readiness_report_id must equal change_id + '_readiness'")
        expected_agent = agent_from_change_id(change_id)
        if expected_agent and report.get("agent") != expected_agent:
            errors.append(f"{path}: agent must match the agent segment in change_id")

    gates = report.get("gates") if isinstance(report.get("gates"), list) else []
    blocking_count = len([gate for gate in gates if isinstance(gate, dict) and gate.get("blocking") is True])
    if report.get("gate_count") != len(gates):
        errors.append(f"{path}: gate_count must equal number of gates")
    if report.get("blocking_count") != blocking_count:
        errors.append(f"{path}: blocking_count must equal number of blocking gates")

    gate_names: list[str] = [gate.get("name") for gate in gates if isinstance(gate, dict) and isinstance(gate.get("name"), str)]
    duplicates = sorted({name for name in gate_names if gate_names.count(name) > 1})
    if duplicates:
        errors.append(f"{path}: duplicate gate names are not allowed: {duplicates}")

    gate_by_name = {gate.get("name"): gate for gate in gates if isinstance(gate, dict)}
    missing_required = sorted(REQUIRED_PRE_APPLY_GATES - set(gate_by_name))
    if missing_required:
        errors.append(f"{path}: missing required pre-apply gates {missing_required}")

    report_status = report.get("status")
    for required_name in sorted(REQUIRED_PRE_APPLY_GATES & set(gate_by_name)):
        validate_required_gate(gate_by_name[required_name], f"{path}: gate {required_name!r}", report_status, errors)

    for index, gate in enumerate(gates):
        if not isinstance(gate, dict):
            continue
        label = f"{path}: gates[{index}]"
        name = gate.get("name")
        status = gate.get("status")
        blocking = gate.get("blocking")
        required_before_apply = gate.get("required_before_apply")
        phase = gate.get("phase")
        if required_before_apply is True and phase != "pre_apply":
            errors.append(f"{label}: gates required before apply must be pre_apply phase")
        if required_before_apply is True and status != "present":
            if blocking is not True:
                errors.append(f"{label}: missing/blocked required gate must be blocking")
        if status == "blocked" and blocking is not True:
            errors.append(f"{label}: blocked status must be blocking")
        if name == "post_apply_validation" and required_before_apply is True:
            errors.append(f"{label}: post_apply_validation cannot be required before apply")
        evidence_path = gate.get("evidence_path")
        evidence_hash = gate.get("evidence_sha256")
        if not is_safe_relative_path(evidence_path):
            errors.append(f"{label}: evidence_path must be a safe relative path")
            continue
        if require_evidence_files and required_before_apply is True:
            file_path = root / str(evidence_path)
            if not file_path.exists():
                errors.append(f"{label}: required evidence file is missing: {evidence_path}")
            elif evidence_hash != sha256_file(file_path):
                errors.append(f"{label}: evidence_sha256 does not match {evidence_path}")

    if report_status == "evidence_complete_not_authorized" and blocking_count:
        errors.append(f"{path}: complete evidence status cannot have blocking gates")
    if report_status == "blocked" and blocking_count == 0:
        errors.append(f"{path}: blocked status requires at least one blocking gate")
    if report_status == "incomplete" and all(isinstance(gate, dict) and gate.get("status") == "present" for gate in gates if gate.get("required_before_apply") is True):
        errors.append(f"{path}: incomplete status requires missing or invalid required pre-apply evidence")
    return errors

def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="check-apply-readiness")
    parser.add_argument("record_paths", nargs="*")
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    parser.add_argument("--require-evidence-files", action="store_true")
    return parser.parse_args(argv)

def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    default_record = root / "docs" / "examples" / "apply-readiness-report.example.yaml"
    record_paths = [Path(value) for value in args.record_paths] if args.record_paths else [default_record]
    schema = load_json(root / "schemas" / "apply-readiness-report.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    errors: list[str] = []
    for path in record_paths:
        errors.extend(validate_report(root, load_yaml(path), path, validator, require_evidence_files=args.require_evidence_files))
    if errors:
        print("apply readiness report validation failed:")
        for error in errors:
            print(f"- {error}")
        return 1
    print("apply readiness report validation passed")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
