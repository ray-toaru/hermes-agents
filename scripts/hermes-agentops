#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
CORE = SCRIPT_DIR / "hermes-agentops-core"
BLOCKED_ENTRYPOINT = SCRIPT_DIR / "run-apply-entrypoint-blocked"


def split_root(argv: list[str]) -> tuple[Path, list[str]]:
    root = Path(".")
    rest: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--root" and index + 1 < len(argv):
            root = Path(argv[index + 1])
            index += 2
            continue
        if arg.startswith("--root="):
            root = Path(arg.split("=", 1)[1])
            index += 1
            continue
        rest.append(arg)
        index += 1
    return root, rest


def rewrite_preflight_paths(root: Path, argv: list[str]) -> list[str]:
    output = list(argv)
    index = 0
    while index < len(output):
        arg = output[index]
        if arg == "--preflight-report" and index + 1 < len(output):
            path = Path(output[index + 1])
            if not path.is_absolute():
                output[index + 1] = str((root / path).resolve())
            index += 2
            continue
        if arg.startswith("--preflight-report="):
            raw = arg.split("=", 1)[1]
            path = Path(raw)
            if not path.is_absolute():
                output[index] = "--preflight-report=" + str((root / path).resolve())
        index += 1
    return output


def main() -> int:
    root, rest = split_root(sys.argv[1:])
    if rest and rest[0] == "apply":
        adapter_args = rewrite_preflight_paths(root, rest[1:])
        os.execv(sys.executable, [sys.executable, str(BLOCKED_ENTRYPOINT), *adapter_args])
    os.execv(sys.executable, [sys.executable, str(CORE), *sys.argv[1:]])
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
