#!/usr/bin/env python3
"""Validate apply lock examples.

This script is intentionally read-only. It validates lock records against
schemas/apply-lock.schema.json and never acquires, releases, or mutates locks.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

import jsonschema
import yaml

from agentops_common import load_yaml, load_json, parse_date_time, sha256_file, agent_from_change_id

DEFAULT_ROOT = Path(__file__).resolve().parents[1]

def validate_lock(
    root: Path,
    lock: Any,
    path: Path,
    validator: jsonschema.Draft202012Validator,
    *,
    require_plan_file: bool,
) -> list[str]:
    errors: list[str] = []
    for error in sorted(validator.iter_errors(lock), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{path}: {location}: {error.message}")
    if not isinstance(lock, dict):
        return errors
    if lock.get("mutation_enabled") is not False:
        errors.append(f"{path}: mutation_enabled must remain false")
    created_at = lock.get("created_at")
    expires_at = lock.get("expires_at")
    if isinstance(created_at, str) and isinstance(expires_at, str):
        try:
            if parse_date_time(expires_at) <= parse_date_time(created_at):
                errors.append(f"{path}: expires_at must be after created_at")
        except ValueError as exc:
            errors.append(f"{path}: invalid timestamp ordering check: {exc}")
    change_id = lock.get("change_id")
    if isinstance(lock.get("lock_id"), str) and isinstance(change_id, str):
        expected_lock_id = f"{change_id}_lock"
        if lock["lock_id"] != expected_lock_id:
            errors.append(f"{path}: lock_id must equal change_id + '_lock'")
    if isinstance(change_id, str):
        expected_agent = agent_from_change_id(change_id)
        if expected_agent and lock.get("agent") != expected_agent:
            errors.append(f"{path}: agent must match the agent segment in change_id")
        plan_path = root / "changes" / change_id / "pre-apply-plan.yaml"
        if plan_path.exists():
            expected_hash = sha256_file(plan_path)
            if lock.get("pre_apply_plan_sha256") != expected_hash:
                errors.append(f"{path}: pre_apply_plan_sha256 does not match {plan_path.relative_to(root)}")
        elif require_plan_file:
            errors.append(f"{path}: required pre-apply plan file is missing: {plan_path.relative_to(root)}")
    return errors

def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="check-apply-lock")
    parser.add_argument("lock_paths", nargs="*")
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    parser.add_argument("--require-plan-file", action="store_true")
    return parser.parse_args(argv)

def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    default_lock = root / "docs" / "examples" / "apply-lock.example.yaml"
    lock_paths = [Path(value) for value in args.lock_paths] if args.lock_paths else [default_lock]
    schema = load_json(root / "schemas" / "apply-lock.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())

    errors: list[str] = []
    for path in lock_paths:
        errors.extend(validate_lock(root, load_yaml(path), path, validator, require_plan_file=args.require_plan_file))

    if errors:
        print("apply lock validation failed:")
        for error in errors:
            print(f"- {error}")
        return 1

    print("apply lock validation passed")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
