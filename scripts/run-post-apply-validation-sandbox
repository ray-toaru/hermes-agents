#!/usr/bin/env python3
"""Run sandbox-only post-apply validation for an AgentOps change.

This command is not real apply. It validates the source change with existing
strict gates, copies reviewed non-runtime directories into a throwaway temporary
workspace, applies the patch inside that sandbox only, runs allowlisted
validation commands after the sandbox mutation, and emits evidence. It never
mutates source managed profiles, enables apply, releases locks, executes
rollback, creates audit records, reads secrets, mutates runtime state, or
orchestrates business work.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import jsonschema
import yaml

DEFAULT_ROOT = Path(__file__).resolve().parents[1]
COPY_DIRS = ("profiles", "policies", "schemas", "scripts", "inventory")
FORBIDDEN_PATH_PARTS = {".git", "logs", "sessions", "workspace", "workspaces", "runtime"}
FORBIDDEN_FILENAMES = {".env", "secrets.json", "state.db"}
VALIDATION_COMMANDS = (
    ("agentops.validate-schemas", [sys.executable, "scripts/hermes-agentops", "validate-schemas"]),
    ("agentops.validate-profiles", [sys.executable, "scripts/hermes-agentops", "validate", "-v"]),
    ("git.diff-check", ["git", "diff", "--check"]),
)


def load_yaml(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def hash_tree(path: Path) -> str:
    digest = hashlib.sha256()
    if not path.exists():
        digest.update(b"<missing>")
        return digest.hexdigest()
    for file_path in sorted(item for item in path.rglob("*") if item.is_file()):
        relative = file_path.relative_to(path).as_posix()
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(file_path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def utc_now_compact() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def run_command(argv: list[str], cwd: Path, *, input_text: str | None = None, timeout: int = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        cwd=cwd,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
        env={},
    )


def validate_copy_source(path: Path) -> None:
    for item in path.rglob("*"):
        rel_parts = item.relative_to(path).parts
        if item.is_symlink():
            raise RuntimeError(f"refusing to copy symlink: {item}")
        if any(part in FORBIDDEN_PATH_PARTS for part in rel_parts):
            raise RuntimeError(f"refusing to copy runtime path: {item}")
        if item.name in FORBIDDEN_FILENAMES:
            raise RuntimeError(f"refusing to copy secret/runtime file: {item}")


def copy_workspace(root: Path, sandbox: Path) -> None:
    for dirname in COPY_DIRS:
        source = root / dirname
        if not source.exists():
            continue
        validate_copy_source(source)
        shutil.copytree(source, sandbox / dirname, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))


def init_sandbox_git(sandbox: Path) -> None:
    commands = (
        ["git", "init"],
        ["git", "config", "user.email", "sandbox@example.local"],
        ["git", "config", "user.name", "sandbox"],
        ["git", "add", "profiles", "policies", "schemas", "scripts", "inventory"],
        ["git", "commit", "-m", "sandbox baseline"],
    )
    for command in commands:
        process = run_command(command, sandbox)
        if process.returncode != 0:
            raise RuntimeError(process.stderr.strip() or process.stdout.strip() or f"command failed: {command}")


def verify_change(root: Path, change_id: str) -> subprocess.CompletedProcess[str]:
    tool = DEFAULT_ROOT / "scripts" / "hermes-agentops"
    return subprocess.run(
        [
            sys.executable,
            str(tool),
            "--root",
            str(root),
            "changes",
            "verify",
            change_id,
            "--check-git-clean",
            "--check-patch-applicable",
        ],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def command_record(command_id: str, argv: list[str], process: subprocess.CompletedProcess[str]) -> dict[str, Any]:
    output = (process.stdout + process.stderr).strip()
    status = "success" if process.returncode == 0 else "failed"
    summary = output[:240] if output else f"{command_id} exited {process.returncode} with no output"
    return {
        "command_id": command_id,
        "argv": argv,
        "exit_code": process.returncode,
        "status": status,
        "stdout_sha256": sha256_text(process.stdout),
        "stderr_sha256": sha256_text(process.stderr),
        "redacted_summary": summary,
    }


def boundaries() -> dict[str, bool]:
    return {
        "temporary_workspace_only": True,
        "does_not_enable_apply": True,
        "does_not_mutate_source_profiles": True,
        "does_not_acquire_or_release_locks": True,
        "does_not_execute_rollback": True,
        "does_not_create_audit_records": True,
        "does_not_read_secret_values": True,
        "does_not_mutate_runtime_state": True,
        "business_orchestration_not_authorized": True,
    }


def failure_recovery() -> dict[str, Any]:
    return {
        "manual_review_required": True,
        "rollback_not_executed_by_runner": True,
        "lock_release_not_performed_by_runner": True,
        "note": "Sandbox validation failure does not execute rollback or release locks; future real pipelines must require manual review on uncertainty.",
    }


def build_report(
    *,
    change_id: str,
    agent: str,
    source_profile_hash_before: str,
    source_profile_hash_after: str,
    sandbox_patch_applied: bool,
    validation_commands: list[dict[str, Any]],
) -> dict[str, Any]:
    source_unchanged = source_profile_hash_before == source_profile_hash_after
    commands_success = bool(validation_commands) and all(item["status"] == "success" for item in validation_commands)
    status = "success" if source_unchanged and sandbox_patch_applied and commands_success else "failed_closed"
    parts = change_id.split("_")
    if len(parts) != 3:
        raise RuntimeError("change_id must have timestamp_agent_digest format")
    return {
        "schema_version": 1,
        "post_apply_validation_run_id": f"{utc_now_compact()}_{parts[1]}_{parts[2]}_post_apply_validation_run",
        "change_id": change_id,
        "agent": agent,
        "generated_at": utc_now_iso(),
        "generated_by": "run-post-apply-validation-sandbox",
        "sandbox_only": True,
        "mutation_enabled": False,
        "apply_authorized": False,
        "status": status,
        "source_profile_hash_before": source_profile_hash_before,
        "source_profile_hash_after": source_profile_hash_after,
        "source_profiles_unchanged": source_unchanged,
        "sandbox_patch_applied": sandbox_patch_applied,
        "validation_commands": validation_commands,
        "boundaries": boundaries(),
        "failure_recovery": failure_recovery(),
    }


def validate_report(root: Path, report: dict[str, Any]) -> list[str]:
    schema = load_json(root / "schemas" / "post-apply-validation-run.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    return [
        f"{'.'.join(str(part) for part in error.path) or '<root>'}: {error.message}"
        for error in sorted(validator.iter_errors(report), key=lambda item: list(item.path))
    ]


def run_validation(root: Path, change_id: str) -> tuple[int, dict[str, Any] | None, str]:
    proposal_path = root / "changes" / change_id / "proposal.yaml"
    diff_path = root / "changes" / change_id / "diff.patch"
    if not proposal_path.exists() or not diff_path.exists():
        return 2, None, "change proposal or diff is missing"
    proposal = load_yaml(proposal_path)
    if not isinstance(proposal, dict):
        return 2, None, "proposal must be a mapping"
    agent = proposal.get("agent")
    if not isinstance(agent, str) or not agent:
        return 2, None, "proposal.agent must be a non-empty string"
    source_profile = root / "profiles" / agent
    source_profile_hash_before = hash_tree(source_profile)
    validation_commands: list[dict[str, Any]] = []
    sandbox_patch_applied = False

    strict = verify_change(root, change_id)
    if strict.returncode != 0:
        return 2, None, (strict.stdout + strict.stderr).strip() or "strict change verification failed"

    try:
        with tempfile.TemporaryDirectory(prefix="hermes-post-apply-validation-") as tmpdir:
            sandbox = Path(tmpdir)
            copy_workspace(root, sandbox)
            init_sandbox_git(sandbox)
            diff_text = diff_path.read_text(encoding="utf-8")
            patch = run_command(["git", "apply"], sandbox, input_text=diff_text)
            if patch.returncode != 0:
                validation_commands.append(command_record("git.apply", ["git", "apply"], patch))
            else:
                sandbox_patch_applied = True
                for command_id, argv in VALIDATION_COMMANDS:
                    process = run_command(argv, sandbox)
                    validation_commands.append(command_record(command_id, argv, process))
    except Exception as exc:
        return 2, None, str(exc)

    source_profile_hash_after = hash_tree(source_profile)
    report = build_report(
        change_id=change_id,
        agent=agent,
        source_profile_hash_before=source_profile_hash_before,
        source_profile_hash_after=source_profile_hash_after,
        sandbox_patch_applied=sandbox_patch_applied,
        validation_commands=validation_commands,
    )
    errors = validate_report(root, report)
    if errors:
        return 2, None, "post-apply validation run evidence validation failed: " + "; ".join(errors)
    return (0 if report["status"] == "success" else 2), report, ""


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="run-post-apply-validation-sandbox")
    parser.add_argument("change_id")
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    code, report, error = run_validation(root, args.change_id)
    if report is not None:
        print(yaml.safe_dump(report, sort_keys=False), end="")
    if error:
        print(f"post-apply validation sandbox runner failed: {error}", file=sys.stderr)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
