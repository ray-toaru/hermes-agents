{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/apply-lock.schema.json",
  "title": "Hermes AgentOps Apply Lock",
  "description": "A governance record schema for a future exclusive apply lock. This schema does not enable apply or acquire locks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_id",
    "change_id",
    "agent",
    "scope",
    "mode",
    "status",
    "created_at",
    "created_by",
    "expires_at",
    "base_commit",
    "pre_apply_plan_sha256",
    "mutation_enabled",
    "recovery"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "lock_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}_lock$"},
    "change_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}$"},
    "agent": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "scope": {"type": "string", "enum": ["repository"]},
    "mode": {"type": "string", "enum": ["exclusive"]},
    "status": {"type": "string", "enum": ["active", "released", "stale", "recovery_required"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "pre_apply_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mutation_enabled": {"type": "boolean", "const": false},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_review_required", "stale_lock_action", "note"],
      "properties": {
        "manual_review_required": {"type": "boolean", "const": true},
        "stale_lock_action": {"type": "string", "enum": ["inspect_before_release"]},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
