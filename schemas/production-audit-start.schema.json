{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/production-audit-start.schema.json",
  "title": "Hermes AgentOps Production Audit-Start Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_start_id", "generated_at", "generated_by", "status", "design_only", "mutation_enabled", "apply_authorized", "production_audit_write_implemented", "production_audit_written", "audit_start_record_created", "pre_mutation_only", "repository", "change_id", "agent", "operator", "evidence_bindings", "audit_sequence", "failure_policy", "production_blockers", "design_documents", "boundaries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "audit_start_id": {"type": "string", "const": "production_audit_start/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "const": "v2.11-production-audit-start"},
    "status": {"type": "string", "const": "design_prototype_only"},
    "design_only": {"type": "boolean", "const": true},
    "mutation_enabled": {"type": "boolean", "const": false},
    "apply_authorized": {"type": "boolean", "const": false},
    "production_audit_write_implemented": {"type": "boolean", "const": false},
    "production_audit_written": {"type": "boolean", "const": false},
    "audit_start_record_created": {"type": "boolean", "const": false},
    "pre_mutation_only": {"type": "boolean", "const": true},
    "repository": {"type": "object", "additionalProperties": false, "required": ["name", "default_branch", "head_sha"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "default_branch": {"type": "string"}, "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "change_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}$"},
    "agent": {"type": "string"},
    "operator": {"type": "string", "minLength": 1},
    "evidence_bindings": {"type": "object", "additionalProperties": false, "required": ["authenticated_approval_evidence_sha256", "readiness_report_sha256", "production_lock_lifecycle_contract_sha256", "production_lock_skeleton_run_sha256", "rollback_point_evidence_sha256", "structured_mutation_command_sha256", "pre_mutation_profile_hash_sha256"], "patternProperties": {".*_sha256$": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "audit_sequence": {"type": "object", "additionalProperties": false, "required": ["audit_start_before_mutation", "mutation_command_dispatched", "completion_audit_required_before_release", "release_blocked_without_completion_audit", "rollback_executed"], "properties": {"audit_start_before_mutation": {"type": "boolean", "const": true}, "mutation_command_dispatched": {"type": "boolean", "const": false}, "completion_audit_required_before_release": {"type": "boolean", "const": true}, "release_blocked_without_completion_audit": {"type": "boolean", "const": true}, "rollback_executed": {"type": "boolean", "const": false}}},
    "failure_policy": {"type": "object", "additionalProperties": false, "required": ["missing_audit_start_blocks_mutation", "audit_start_write_failure_preserves_lock", "unknown_state_preserves_lock", "manual_review_before_retry"], "patternProperties": {".*": {"type": "boolean", "const": true}}},
    "production_blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "design_documents": {"type": "object", "additionalProperties": false, "required": ["audit_capture_design"], "properties": {"audit_capture_design": {"type": "object", "additionalProperties": false, "required": ["path", "required_phrases"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+"}, "required_phrases": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["does_not_enable_apply", "does_not_write_production_audit_records", "does_not_dispatch_mutation", "does_not_release_production_locks", "does_not_mutate_profiles", "does_not_execute_rollback", "does_not_read_secret_values", "does_not_mutate_runtime_state", "business_orchestration_not_authorized"], "patternProperties": {".*": {"type": "boolean", "const": true}}}
  }
}
