{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/post-apply-validation-run.schema.json",
  "title": "Hermes AgentOps Sandbox Post-Apply Validation Run Evidence",
  "description": "Sandbox-only evidence emitted after applying a change inside a temporary workspace and running allowlisted validation commands. This schema does not enable real apply, mutate source profiles, release locks, execute rollback, create audit records, read secrets, mutate runtime state, or orchestrate business work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "post_apply_validation_run_id",
    "change_id",
    "agent",
    "generated_at",
    "generated_by",
    "sandbox_only",
    "mutation_enabled",
    "apply_authorized",
    "status",
    "source_profile_hash_before",
    "source_profile_hash_after",
    "source_profiles_unchanged",
    "sandbox_patch_applied",
    "validation_commands",
    "boundaries",
    "failure_recovery"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "post_apply_validation_run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}_post_apply_validation_run$"},
    "change_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}$"},
    "agent": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "const": "run-post-apply-validation-sandbox"},
    "sandbox_only": {"type": "boolean", "const": true},
    "mutation_enabled": {"type": "boolean", "const": false},
    "apply_authorized": {"type": "boolean", "const": false},
    "status": {"type": "string", "enum": ["success", "failed_closed"]},
    "source_profile_hash_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_profile_hash_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_profiles_unchanged": {"type": "boolean", "const": true},
    "sandbox_patch_applied": {"type": "boolean"},
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "argv", "exit_code", "status", "stdout_sha256", "stderr_sha256", "redacted_summary"],
        "properties": {
          "command_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
          "status": {"type": "string", "enum": ["success", "failed"]},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "redacted_summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_workspace_only",
        "does_not_enable_apply",
        "does_not_mutate_source_profiles",
        "does_not_acquire_or_release_locks",
        "does_not_execute_rollback",
        "does_not_create_audit_records",
        "does_not_read_secret_values",
        "does_not_mutate_runtime_state",
        "business_orchestration_not_authorized"
      ],
      "properties": {
        "temporary_workspace_only": {"type": "boolean", "const": true},
        "does_not_enable_apply": {"type": "boolean", "const": true},
        "does_not_mutate_source_profiles": {"type": "boolean", "const": true},
        "does_not_acquire_or_release_locks": {"type": "boolean", "const": true},
        "does_not_execute_rollback": {"type": "boolean", "const": true},
        "does_not_create_audit_records": {"type": "boolean", "const": true},
        "does_not_read_secret_values": {"type": "boolean", "const": true},
        "does_not_mutate_runtime_state": {"type": "boolean", "const": true},
        "business_orchestration_not_authorized": {"type": "boolean", "const": true}
      }
    },
    "failure_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_review_required", "rollback_not_executed_by_runner", "lock_release_not_performed_by_runner", "note"],
      "properties": {
        "manual_review_required": {"type": "boolean", "const": true},
        "rollback_not_executed_by_runner": {"type": "boolean", "const": true},
        "lock_release_not_performed_by_runner": {"type": "boolean", "const": true},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
