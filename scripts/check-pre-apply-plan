#!/usr/bin/env python3
"""Validate pre-apply plan examples.

This script is intentionally read-only. It validates plan files against
schemas/pre-apply-plan.schema.json and never applies patches or mutates profiles.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path
from typing import Any

import jsonschema
import yaml

from agentops_common import load_yaml, load_json, agent_from_change_id

ROOT = Path(__file__).resolve().parents[1]
SCHEMA = ROOT / "schemas" / "pre-apply-plan.schema.json"
DEFAULT_PLAN = ROOT / "docs" / "examples" / "pre-apply-plan.example.yaml"

def validate_plan(plan: Any, path: Path, validator: jsonschema.Draft202012Validator) -> list[str]:
    errors: list[str] = []
    for error in sorted(validator.iter_errors(plan), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{path}: {location}: {error.message}")
    if not isinstance(plan, dict):
        return errors
    if plan.get("mutation_enabled") is not False:
        errors.append(f"{path}: mutation_enabled must remain false")

    change_id = plan.get("change_id")
    if isinstance(change_id, str):
        if plan.get("plan_id") != f"{change_id}_preapply":
            errors.append(f"{path}: plan_id must equal change_id + '_preapply'")
        expected_agent = agent_from_change_id(change_id)
        if expected_agent and plan.get("agent") != expected_agent:
            errors.append(f"{path}: agent must match the agent segment in change_id")
        expected_audit_path = f"changes/{change_id}/pre-apply-plan.yaml"
        audit = plan.get("audit")
        if isinstance(audit, dict) and audit.get("record_path") != expected_audit_path:
            errors.append(f"{path}: audit.record_path must equal {expected_audit_path}")
    return errors

def main(argv: list[str] | None = None) -> int:
    argv = list(argv or sys.argv[1:])
    plan_paths = [Path(value) for value in argv] if argv else [DEFAULT_PLAN]

    schema = load_json(SCHEMA)
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())

    errors: list[str] = []
    for path in plan_paths:
        errors.extend(validate_plan(load_yaml(path), path, validator))

    if errors:
        print("pre-apply plan validation failed:")
        for error in errors:
            print(f"- {error}")
        return 1

    print("pre-apply plan validation passed")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
