#!/usr/bin/env python3
"""Generate a non-mutating pre-apply plan for a verified change.

This command writes a governance record only. It does not apply patches, create
locks, write runtime state, read secrets, or mutate managed profiles.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import jsonschema
import yaml


def load_yaml(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def write_yaml(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        yaml.safe_dump(data, handle, allow_unicode=True, sort_keys=False)


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def run_command(command: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=cwd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)


def require_success(process: subprocess.CompletedProcess[str], label: str) -> None:
    if process.returncode != 0:
        details = (process.stdout + process.stderr).strip()
        raise RuntimeError(f"{label} failed: {details}")


def git_head(root: Path) -> str:
    process = run_command(["git", "rev-parse", "HEAD"], root)
    require_success(process, "git rev-parse HEAD")
    return process.stdout.strip()


def verify_change(root: Path, change_id: str) -> None:
    tool = Path(__file__).resolve().parent / "hermes-agentops"
    process = run_command(
        [
            sys.executable,
            str(tool),
            "--root",
            str(root),
            "changes",
            "verify",
            change_id,
            "--check-git-clean",
            "--check-patch-applicable",
        ],
        root,
    )
    require_success(process, "changes verify --check-git-clean --check-patch-applicable")


def validate_plan(root: Path, plan: dict[str, Any]) -> list[str]:
    schema_path = root / "schemas" / "pre-apply-plan.schema.json"
    schema = load_json(schema_path)
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    errors = []
    for error in sorted(validator.iter_errors(plan), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{location}: {error.message}")
    if plan.get("mutation_enabled") is not False:
        errors.append("mutation_enabled must remain false")
    return errors


def build_plan(root: Path, change_id: str, base_commit: str, generated_at: str) -> dict[str, Any]:
    proposal_path = root / "changes" / change_id / "proposal.yaml"
    proposal = load_yaml(proposal_path)
    if not isinstance(proposal, dict):
        raise RuntimeError(f"proposal must be a mapping: {proposal_path}")
    agent = proposal.get("agent")
    diff_hash = proposal.get("diff_sha256")
    if not isinstance(agent, str) or not isinstance(diff_hash, str):
        raise RuntimeError("proposal must include string agent and diff_sha256")
    return {
        "schema_version": 1,
        "plan_id": f"{change_id}_preapply",
        "change_id": change_id,
        "agent": agent,
        "generated_at": generated_at,
        "mutation_enabled": False,
        "base_commit": base_commit,
        "proposal_diff_sha256": diff_hash,
        "gates": {
            "policy_valid": True,
            "proposal_valid": True,
            "approvals_valid": True,
            "diff_hash_valid": True,
            "path_scope_valid": True,
            "git_clean_required": True,
            "patch_applicable_required": True,
            "manual_operator_confirmation_required": True,
        },
        "lock": {
            "required": True,
            "scope": "repository",
            "mode": "exclusive",
            "stale_after_seconds": 900,
            "note": "Future apply must acquire one exclusive repository-level lock before mutation.",
        },
        "rollback": {
            "required": True,
            "strategy": "git_first",
            "pre_apply_commit_required": True,
            "note": "Future apply must record HEAD before mutation and support reverting the resulting commit.",
        },
        "post_apply_validation": {
            "required": True,
            "commands": [
                "python scripts/hermes-agentops validate-schemas",
                "python scripts/hermes-agentops validate -v",
                "pytest -q",
            ],
        },
        "audit": {
            "required": True,
            "record_path": f"changes/{change_id}/pre-apply-plan.yaml",
            "include_stdout_stderr": True,
            "include_exit_codes": True,
            "include_git_head_before_after": True,
        },
        "failure_recovery": {
            "abort_on_first_failure": True,
            "rollback_on_partial_mutation": True,
            "leave_lock_for_manual_recovery": True,
            "note": "Future apply must fail closed and preserve evidence for manual inspection.",
        },
    }


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="generate-pre-apply-plan")
    parser.add_argument("change_id")
    parser.add_argument("--root", default=".")
    parser.add_argument("--output", help="Output path. Defaults to changes/<change_id>/pre-apply-plan.yaml")
    parser.add_argument("--overwrite", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    output = Path(args.output) if args.output else root / "changes" / args.change_id / "pre-apply-plan.yaml"
    if not output.is_absolute():
        output = root / output
    if output.exists() and not args.overwrite:
        print(f"[CRIT] preapply.output: already exists {output}")
        return 2
    try:
        verify_change(root, args.change_id)
        plan = build_plan(root, args.change_id, git_head(root), utc_now_iso())
        errors = validate_plan(root, plan)
        if errors:
            for error in errors:
                print(f"[CRIT] preapply.plan: {error}")
            return 2
        write_yaml(output, plan)
        print(output.relative_to(root) if output.is_relative_to(root) else output)
        return 0
    except Exception as exc:
        print(f"[CRIT] preapply.generate: {exc}")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
