{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/guard-write-path-decision.schema.json",
  "title": "Hermes AgentOps Guard Write Path Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "decision", "guard_write_enabled", "acquire_enabled", "release_enabled", "unknown_state_preserves_guard", "manual_review_required", "blockers"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "decision_id": {"type": "string", "const": "guard_write_path_decision/v1"},
    "decision": {"type": "string", "const": "deferred"},
    "guard_write_enabled": {"type": "boolean", "const": false},
    "acquire_enabled": {"type": "boolean", "const": false},
    "release_enabled": {"type": "boolean", "const": false},
    "unknown_state_preserves_guard": {"type": "boolean", "const": true},
    "manual_review_required": {"type": "boolean", "const": true},
    "blockers": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
