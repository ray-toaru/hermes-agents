#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

try:
    import yaml
except Exception:  # pragma: no cover
    yaml = None


def load_yaml(path: Path) -> dict:
    if yaml is None:
        raise RuntimeError("PyYAML is required")
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError(f"{path} must contain a mapping")
    return data


def build_report(change_id: str | None, preflight_report: Path | None) -> dict:
    blockers = ["real_apply_deferred", "apply_disabled"]
    preflight = {"path": None, "present": False, "decision": None}
    if preflight_report is None:
        blockers.append("preflight_report_not_provided")
    else:
        preflight["path"] = str(preflight_report)
        if not preflight_report.exists():
            blockers.append("preflight_report_missing")
        else:
            preflight["present"] = True
            try:
                data = load_yaml(preflight_report)
                preflight["decision"] = data.get("decision")
                if data.get("decision") != "blocked":
                    blockers.append("preflight_not_blocked")
            except Exception as exc:
                preflight["decision"] = "invalid"
                preflight["error"] = str(exc)
                blockers.append("preflight_report_invalid")
    return {
        "schema_version": 1,
        "report_id": "apply_blocked_report/v1",
        "decision": "blocked",
        "change_id": change_id,
        "preflight_report": preflight,
        "boundaries": {
            "apply_authorized": False,
            "mutation_allowed": False,
            "profile_write_allowed": False,
            "runtime_write_allowed": False,
            "lock_acquire_allowed": False,
            "audit_write_allowed": False,
            "command_execution_allowed": False,
        },
        "blockers": blockers,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("change_id", nargs="?")
    parser.add_argument("--preflight-report", type=Path)
    args = parser.parse_args(argv)
    print(json.dumps(build_report(args.change_id, args.preflight_report), ensure_ascii=False, indent=2, sort_keys=True))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
