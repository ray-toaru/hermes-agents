#!/usr/bin/env python3
"""Minimal Hermes AgentOps CLI.

Management-plane only: validates governance files, inventory, schemas, and change
workflow records. It does not apply changes, read secrets, orchestrate business
tasks, or mutate runtime state.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except Exception:
    yaml = None

try:
    import jsonschema
except Exception:
    jsonschema = None

REQUIRED_PROFILE_FILES = ["SOUL.md", "config.yaml", "manifest.yaml"]
FORBIDDEN_NAMES = {".env", "state.db", "secrets.json"}
DEFAULT_GLOBAL_FORBIDDEN = {
    "read_secret_values",
    "execute_business_actions",
    "bypass_approval",
    "delete_runtime_state",
    "bypass_hermes_runtime_provider",
    "bypass_hermes_tool_registry",
}
RISK_APPROVALS = {"low": 1, "medium": 1, "high": 2, "critical": 2}
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,62}$")


def load_yaml(path: Path):
    if yaml is None:
        raise RuntimeError("PyYAML is required: python -m pip install pyyaml")
    with path.open("r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def write_yaml(path: Path, data) -> None:
    if yaml is None:
        raise RuntimeError("PyYAML is required: python -m pip install pyyaml")
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        yaml.safe_dump(data, f, allow_unicode=True, sort_keys=False)


def load_json(path: Path):
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def validate_with_schema(instance, schema_path: Path, errors: list[str], label: str) -> None:
    if not schema_path.exists():
        errors.append(f"[CRIT] schema.{label}: missing {schema_path}")
        return
    if jsonschema is None:
        return
    try:
        schema = load_json(schema_path)
        jsonschema.Draft202012Validator.check_schema(schema)
        jsonschema.validate(instance=instance, schema=schema)
    except Exception as exc:
        errors.append(f"[CRIT] schema.{label}: {exc}")


def global_forbidden(root: Path) -> set[str]:
    path = root / "policies" / "global-permissions.yaml"
    if not path.exists():
        return set(DEFAULT_GLOBAL_FORBIDDEN)
    data = load_yaml(path)
    values = (data or {}).get("global_forbidden") or []
    return set(values) | set(DEFAULT_GLOBAL_FORBIDDEN)


def validate_profile(root: Path, name: str) -> int:
    profile_dir = root / "profiles" / name
    errors: list[str] = []

    if not profile_dir.exists():
        print(f"[CRIT] profile.exists: missing {profile_dir}")
        return 2

    for rel in REQUIRED_PROFILE_FILES:
        path = profile_dir / rel
        if not path.exists():
            errors.append(f"[CRIT] file.{rel}: missing")
        elif path.stat().st_size == 0:
            errors.append(f"[CRIT] file.{rel}: empty")

    for path in profile_dir.rglob("*"):
        if not path.is_file():
            continue
        if path.name in FORBIDDEN_NAMES:
            errors.append(f"[CRIT] forbidden_file: {path.relative_to(root)}")
        parts = set(path.relative_to(profile_dir).parts)
        if parts & {"logs", "sessions", "workspace", "workspaces"}:
            errors.append(f"[CRIT] runtime_file: {path.relative_to(root)}")

    manifest_path = profile_dir / "manifest.yaml"
    if manifest_path.exists():
        try:
            manifest = load_yaml(manifest_path)
            if not isinstance(manifest, dict):
                errors.append("[CRIT] manifest: must be a mapping")
            else:
                validate_with_schema(manifest, root / "schemas" / "manifest.schema.json", errors, "manifest")
                if manifest.get("name") != name:
                    errors.append(f"[CRIT] manifest.name: expected {name!r}")
                if manifest.get("type") != "hermes-agent-profile":
                    errors.append("[CRIT] manifest.type: must be hermes-agent-profile")
                secrets = manifest.get("secrets") or {}
                if secrets.get("readable_by_agentops") is not False:
                    errors.append("[CRIT] secrets.readable_by_agentops: must be false")
                permissions = manifest.get("permissions") or {}
                allowed = set(permissions.get("allowed") or [])
                approval = set(permissions.get("requires_approval") or [])
                forbidden = set(permissions.get("forbidden") or [])
                missing = global_forbidden(root) - forbidden
                if missing:
                    errors.append(f"[CRIT] permissions.forbidden: missing global forbidden {sorted(missing)}")
                overlap = (allowed | approval) & forbidden
                if overlap:
                    errors.append(f"[CRIT] permissions.conflict: allowed/approval overlaps forbidden {sorted(overlap)}")
        except Exception as exc:
            errors.append(f"[CRIT] manifest.parse: {exc}")

    for error in errors:
        print(error)
    return 2 if errors else 0


def load_inventory(root: Path):
    path = root / "inventory" / "agents.yaml"
    if not path.exists():
        return {"agents": []}
    data = load_yaml(path)
    if not isinstance(data, dict):
        raise RuntimeError("inventory/agents.yaml must be a mapping")
    data.setdefault("agents", [])
    return data


def cmd_validate(args) -> int:
    root = Path(args.root).resolve()
    if args.agent:
        return validate_profile(root, args.agent)
    inventory = load_inventory(root)
    code = 0
    for item in inventory.get("agents", []):
        if not isinstance(item, dict) or not item.get("name"):
            print("[CRIT] inventory: invalid agent entry")
            code = 2
            continue
        code = max(code, validate_profile(root, item["name"]))
    return code


def cmd_inventory_list(args) -> int:
    root = Path(args.root).resolve()
    inventory = load_inventory(root)
    for item in inventory.get("agents", []):
        if isinstance(item, dict):
            print(f"{item.get('name')}\t{item.get('status')}\t{item.get('profile_dir')}")
    return 0


def cmd_validate_schemas(args) -> int:
    root = Path(args.root).resolve()
    errors: list[str] = []
    for path in sorted((root / "schemas").glob("*.schema.json")):
        try:
            schema = load_json(path)
            if jsonschema is not None:
                jsonschema.Draft202012Validator.check_schema(schema)
        except Exception as exc:
            errors.append(f"[CRIT] schema.{path.name}: {exc}")
    for error in errors:
        print(error)
    return 2 if errors else 0


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def utc_now_compact() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def slug(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_.-]+", "-", value.strip().lower()).strip("-") or "record"


def change_dir(root: Path, change_id: str) -> Path:
    return root / "changes" / change_id


def load_change_proposal(root: Path, change_id: str, errors: list[str]):
    path = change_dir(root, change_id) / "proposal.yaml"
    if not path.exists():
        errors.append(f"[CRIT] change.proposal: missing {path}")
        return None
    try:
        data = load_yaml(path)
        if not isinstance(data, dict):
            errors.append("[CRIT] change.proposal: must be a mapping")
            return None
        validate_with_schema(data, root / "schemas" / "change-proposal.schema.json", errors, "change-proposal")
        return data
    except Exception as exc:
        errors.append(f"[CRIT] change.proposal.parse: {exc}")
        return None


def diff_paths(diff_text: str) -> set[str]:
    paths: set[str] = set()
    for line in diff_text.splitlines():
        if line.startswith("+++ b/") or line.startswith("--- a/"):
            path = line[6:]
            if path != "/dev/null":
                paths.add(path)
    return paths


def git_diff(root: Path, agent: str, staged: bool = False) -> str:
    cmd = ["git", "diff"]
    if staged:
        cmd.append("--staged")
    cmd += ["--", f"profiles/{agent}"]
    proc = subprocess.run(cmd, cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if proc.returncode not in (0, 1):
        raise RuntimeError(proc.stderr.strip() or "git diff failed")
    return proc.stdout


def approval_records(root: Path, change_id: str) -> list[dict]:
    records = []
    approvals_dir = change_dir(root, change_id) / "approvals"
    if approvals_dir.exists():
        for path in sorted(approvals_dir.glob("*.yaml")):
            data = load_yaml(path)
            if isinstance(data, dict):
                data["_file"] = path.name
                records.append(data)
    return records


def change_status(proposal: dict, approvals: list[dict]) -> str:
    if any(a.get("decision") == "reject" for a in approvals):
        return "rejected"
    approved_by = {a.get("approver") for a in approvals if a.get("decision") == "approve" and a.get("approver")}
    required = int(proposal.get("required_approvals") or RISK_APPROVALS.get(str(proposal.get("risk_level", "medium")), 1))
    if len(approved_by) >= required:
        return "approved"
    if approvals:
        return "partially_approved"
    return "proposed"


def validate_change(root: Path, change_id: str) -> int:
    errors: list[str] = []
    cdir = change_dir(root, change_id)
    if not cdir.exists():
        print(f"[CRIT] change.dir: missing {cdir}")
        return 2

    proposal = load_change_proposal(root, change_id, errors)
    diff_file = cdir / "diff.patch"
    if not diff_file.exists():
        errors.append(f"[CRIT] change.diff: missing {diff_file}")
        diff_text = ""
    else:
        diff_text = diff_file.read_text(encoding="utf-8")

    if proposal:
        expected_hash = proposal.get("diff_sha256")
        actual_hash = sha256_text(diff_text)
        if expected_hash != actual_hash:
            errors.append("[CRIT] change.diff_sha256: proposal hash does not match diff.patch")

        agent = proposal.get("agent")
        if not isinstance(agent, str) or not agent:
            errors.append("[CRIT] change.agent: missing or invalid agent")
        else:
            for path in sorted(diff_paths(diff_text)):
                if not path.startswith(f"profiles/{agent}/"):
                    errors.append(f"[CRIT] change.path_scope: {path} is outside profiles/{agent}/")

        approvals = []
        approvals_dir = cdir / "approvals"
        if approvals_dir.exists():
            for approval_file in sorted(approvals_dir.glob("*.yaml")):
                try:
                    approval = load_yaml(approval_file)
                    if not isinstance(approval, dict):
                        errors.append(f"[CRIT] approval.{approval_file.name}: must be a mapping")
                        continue
                    validate_with_schema(approval, root / "schemas" / "approval-record.schema.json", errors, f"approval-record.{approval_file.name}")
                    if approval.get("change_id") != change_id:
                        errors.append(f"[CRIT] approval.{approval_file.name}: change_id mismatch")
                    if approval.get("diff_sha256") != expected_hash:
                        errors.append(f"[CRIT] approval.{approval_file.name}: diff hash mismatch")
                    approvals.append(approval)
                except Exception as exc:
                    errors.append(f"[CRIT] approval.{approval_file.name}: {exc}")

        if any(a.get("decision") == "reject" for a in approvals):
            errors.append("[CRIT] approval.status: at least one rejection is present")
        approved_by = {a.get("approver") for a in approvals if a.get("decision") == "approve" and a.get("approver")}
        risk = proposal.get("risk_level", "medium")
        required = int(proposal.get("required_approvals") or RISK_APPROVALS.get(str(risk), 1))
        if len(approved_by) < required:
            errors.append(f"[CRIT] approval.threshold: {len(approved_by)} approvals, require {required}")

    for error in errors:
        print(error)
    return 2 if errors else 0


def cmd_changes_propose(args) -> int:
    root = Path(args.root).resolve()
    agent = args.agent
    if not NAME_RE.match(agent):
        print(f"[CRIT] change.agent: invalid agent name {agent!r}")
        return 2
    diff_text = git_diff(root, agent, staged=args.staged)
    if not diff_text.strip() and not args.allow_empty:
        print("[CRIT] change.diff: no Git diff found for profile")
        return 2
    digest = sha256_text(diff_text)
    change_id = f"{utc_now_compact()}_{agent}_{digest[:10]}"
    cdir = change_dir(root, change_id)
    if cdir.exists():
        print(f"[CRIT] change.dir: already exists {cdir}")
        return 2
    required = RISK_APPROVALS[args.risk_level]
    proposal = {
        "schema_version": 1,
        "change_id": change_id,
        "agent": agent,
        "title": args.title,
        "summary": args.summary,
        "reason": args.reason,
        "risk_level": args.risk_level,
        "created_at": utc_now_iso(),
        "created_by": args.created_by,
        "diff_sha256": digest,
        "required_approvals": required,
        "status": "proposed",
        "rollback": {"strategy": "git_first", "note": args.rollback_note},
        "validation": {"required_before_apply": ["changes verify", "profile validate", "git status clean", "rollback point"], "note": args.validation_note},
    }
    write_yaml(cdir / "proposal.yaml", proposal)
    (cdir / "diff.patch").write_text(diff_text, encoding="utf-8")
    (cdir / "approvals").mkdir(parents=True, exist_ok=True)
    (cdir / "README.md").write_text(f"# Change {change_id}\n\nAgent: `{agent}`\n\nTitle: {args.title}\n", encoding="utf-8")
    print(change_id)
    return 0


def cmd_changes_list(args) -> int:
    root = Path(args.root).resolve()
    croot = root / "changes"
    if not croot.exists():
        return 0
    for cdir in sorted(croot.iterdir()):
        if not cdir.is_dir() or not (cdir / "proposal.yaml").exists():
            continue
        proposal = load_yaml(cdir / "proposal.yaml")
        if not isinstance(proposal, dict):
            continue
        if args.agent and proposal.get("agent") != args.agent:
            continue
        records = approval_records(root, cdir.name)
        print(f"{cdir.name}\t{proposal.get('agent')}\t{proposal.get('risk_level')}\t{change_status(proposal, records)}\t{proposal.get('title')}")
    return 0


def cmd_changes_show(args) -> int:
    root = Path(args.root).resolve()
    errors: list[str] = []
    proposal = load_change_proposal(root, args.change_id, errors)
    if errors or not proposal:
        for error in errors:
            print(error)
        return 2
    records = approval_records(root, args.change_id)
    if args.json:
        print(json.dumps({"proposal": proposal, "status": change_status(proposal, records), "approvals": records}, ensure_ascii=False, indent=2))
        return 0
    print(f"# {args.change_id}")
    print(f"agent: {proposal.get('agent')}")
    print(f"title: {proposal.get('title')}")
    print(f"risk: {proposal.get('risk_level')}")
    print(f"status: {change_status(proposal, records)}")
    print(f"diff_sha256: {proposal.get('diff_sha256')}")
    print(f"approvals: {len([r for r in records if r.get('decision') == 'approve'])}/{proposal.get('required_approvals')}")
    return 0


def cmd_changes_diff(args) -> int:
    root = Path(args.root).resolve()
    path = change_dir(root, args.change_id) / "diff.patch"
    if not path.exists():
        print(f"[CRIT] change.diff: missing {path}")
        return 2
    print(path.read_text(encoding="utf-8"), end="")
    return 0


def cmd_changes_approve(args) -> int:
    root = Path(args.root).resolve()
    errors: list[str] = []
    proposal = load_change_proposal(root, args.change_id, errors)
    if errors or not proposal:
        for error in errors:
            print(error)
        return 2
    diff_file = change_dir(root, args.change_id) / "diff.patch"
    if not diff_file.exists():
        print(f"[CRIT] change.diff: missing {diff_file}")
        return 2
    if sha256_text(diff_file.read_text(encoding="utf-8")) != proposal.get("diff_sha256"):
        print("[CRIT] change.diff_sha256: proposal hash does not match diff.patch")
        return 2
    record = {
        "schema_version": 1,
        "change_id": args.change_id,
        "decision": args.decision,
        "approver": args.approver,
        "created_at": utc_now_iso(),
        "comment": args.comment,
        "diff_sha256": proposal.get("diff_sha256"),
        "acknowledgements": {
            "reviewed_diff": True,
            "understands_apply_not_automatic": True,
            "secret_values_not_reviewed": True,
            "business_orchestration_not_authorized": True,
        },
    }
    path = change_dir(root, args.change_id) / "approvals" / f"{utc_now_compact()}_{slug(args.approver)}_{args.decision}.yaml"
    write_yaml(path, record)
    print(path.relative_to(root))
    return 0


def cmd_changes_verify(args) -> int:
    root = Path(args.root).resolve()
    return validate_change(root, args.change_id)


def cmd_apply(args) -> int:
    print("apply is intentionally not implemented. This command is reserved until preflight, locking, rollback, and post-apply validation are complete.")
    return 1


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="hermes-agentops")
    parser.add_argument("--root", default=".")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("validate")
    p.add_argument("agent", nargs="?")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("validate-schemas")
    p.set_defaults(func=cmd_validate_schemas)

    inv = sub.add_parser("inventory")
    inv_sub = inv.add_subparsers(dest="inventory_cmd", required=True)
    p = inv_sub.add_parser("list")
    p.set_defaults(func=cmd_inventory_list)

    changes = sub.add_parser("changes")
    changes_sub = changes.add_subparsers(dest="changes_cmd", required=True)
    p = changes_sub.add_parser("propose")
    p.add_argument("agent")
    p.add_argument("--title", required=True)
    p.add_argument("--summary", required=True)
    p.add_argument("--reason", required=True)
    p.add_argument("--risk-level", choices=sorted(RISK_APPROVALS), default="medium")
    p.add_argument("--created-by", default="user")
    p.add_argument("--rollback-note", default="Rollback with Git-first strategy, then validate.")
    p.add_argument("--validation-note", default="Run changes verify and profile validation before any future apply.")
    p.add_argument("--staged", action="store_true")
    p.add_argument("--allow-empty", action="store_true")
    p.set_defaults(func=cmd_changes_propose)

    p = changes_sub.add_parser("list")
    p.add_argument("agent", nargs="?")
    p.set_defaults(func=cmd_changes_list)

    p = changes_sub.add_parser("show")
    p.add_argument("change_id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_changes_show)

    p = changes_sub.add_parser("diff")
    p.add_argument("change_id")
    p.set_defaults(func=cmd_changes_diff)

    p = changes_sub.add_parser("approve")
    p.add_argument("change_id")
    p.add_argument("--approver", required=True)
    p.add_argument("--decision", choices=["approve", "reject"], default="approve")
    p.add_argument("--comment", default="")
    p.set_defaults(func=cmd_changes_approve)

    p = changes_sub.add_parser("verify")
    p.add_argument("change_id")
    p.set_defaults(func=cmd_changes_verify)

    p = sub.add_parser("apply")
    p.add_argument("change_id", nargs="?")
    p.set_defaults(func=cmd_apply)

    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
