{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/apply-blocked-report.schema.json",
  "title": "Hermes AgentOps Apply Blocked Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "decision", "change_id", "preflight_report", "boundaries", "blockers"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "report_id": {"type": "string", "const": "apply_blocked_report/v1"},
    "decision": {"type": "string", "const": "blocked"},
    "change_id": {"type": ["string", "null"]},
    "preflight_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "present", "decision"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "present": {"type": "boolean"},
        "decision": {"type": ["string", "null"]}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply_authorized", "mutation_allowed", "profile_write_allowed", "runtime_write_allowed", "lock_acquire_allowed", "audit_write_allowed", "command_execution_allowed"],
      "properties": {
        "apply_authorized": {"type": "boolean", "const": false},
        "mutation_allowed": {"type": "boolean", "const": false},
        "profile_write_allowed": {"type": "boolean", "const": false},
        "runtime_write_allowed": {"type": "boolean", "const": false},
        "lock_acquire_allowed": {"type": "boolean", "const": false},
        "audit_write_allowed": {"type": "boolean", "const": false},
        "command_execution_allowed": {"type": "boolean", "const": false}
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"},
      "contains": {"const": "real_apply_deferred"}
    }
  }
}
