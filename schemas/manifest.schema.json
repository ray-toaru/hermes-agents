{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/manifest.schema.json",
  "title": "Hermes AgentOps Profile Manifest",
  "description": "Governance metadata for a Hermes agent profile. This schema does not replace Hermes config.yaml, SOUL.md, provider runtime resolution, or tools registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "type", "status", "owner", "risk_level", "description", "paths", "runtime", "provider", "secrets", "permissions", "maintenance", "rollback", "audit"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "type": {"type": "string", "const": "hermes-agent-profile"},
    "status": {"type": "string", "enum": ["draft", "active", "paused", "archived"]},
    "owner": {"type": "string", "minLength": 1},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "description": {"type": "string", "minLength": 1},
    "paths": {"type": "object", "additionalProperties": false, "required": ["profile_dir", "workspace_dir", "runtime_home", "log_dir"], "properties": {"profile_dir": {"type": "string", "minLength": 1}, "workspace_dir": {"type": "string", "minLength": 1}, "runtime_home": {"type": "string", "minLength": 1}, "log_dir": {"type": "string", "minLength": 1}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["hermes_profile", "container", "gateway", "cron"], "properties": {"hermes_profile": {"type": "string", "minLength": 1}, "container": {"type": "object", "additionalProperties": false, "required": ["enabled", "engine"], "properties": {"enabled": {"type": "boolean"}, "engine": {"type": "string", "enum": ["podman", "docker", "none"]}, "name": {"type": "string"}}}, "gateway": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}, "cron": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["managed_by", "config_file", "allow_agentops_to_modify"], "properties": {"managed_by": {"type": "string", "const": "hermes_config"}, "config_file": {"type": "string", "const": "config.yaml"}, "allow_agentops_to_modify": {"type": "boolean"}}},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["mode", "required", "readable_by_agentops", "writable_by_agentops"], "properties": {"mode": {"type": "string", "enum": ["reference_only", "secret_manager"]}, "required": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}, "uniqueItems": true}, "readable_by_agentops": {"type": "boolean", "const": false}, "writable_by_agentops": {"type": "boolean"}}},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["allowed", "requires_approval", "forbidden"], "properties": {"allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "requires_approval": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "contains": {"const": "read_secret_values"}}}},
    "maintenance": {"type": "object", "additionalProperties": false, "required": ["health_checks", "auto_fix_allowed", "auto_fix_forbidden"], "properties": {"health_checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "auto_fix_allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "auto_fix_forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["strategy", "require_pre_change_snapshot", "require_validation_after_rollback"], "properties": {"strategy": {"type": "string", "const": "git_first"}, "require_pre_change_snapshot": {"type": "boolean", "const": true}, "require_validation_after_rollback": {"type": "boolean", "const": true}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["changelog", "require_diff", "require_reason", "require_risk_note"], "properties": {"changelog": {"type": "string"}, "require_diff": {"type": "boolean", "const": true}, "require_reason": {"type": "boolean", "const": true}, "require_risk_note": {"type": "boolean", "const": true}}}
  }
}
