{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/capability-ledger.schema.json",
  "title": "Hermes AgentOps Capability Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "items"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "ledger_id": {"type": "string", "const": "capability_ledger/v1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "paths"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "status": {"type": "string", "enum": ["present", "planned", "blocked", "deferred"]},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}}
        }
      }
    }
  }
}
