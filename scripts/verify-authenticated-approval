#!/usr/bin/env python3
"""Generate authenticated approval evidence in read-only verifier modes.

This verifier is intentionally read-only. Implemented modes are:

- ``fixture_contract_only``: converts local repository approval records into the
  authenticated approval evidence contract for tests and future integration
  work. Fixture evidence is not identity proof.
- ``signed_attestation``: verifies local Ed25519-signed approval attestations
  against explicitly configured public trust roots and emits the same evidence
  contract. This mode is read-only and does not contact external services.

The ``live_github`` mode still fails closed until a separate reviewed
integration binds repository reviews, permissions, rejections, and diff state to
live GitHub API evidence.

The verifier does not read secrets, mutate profiles, mutate runtime state,
acquire locks, release locks, execute rollback, or authorize apply.
"""

from __future__ import annotations

import argparse
import base64
import json
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

import jsonschema
import yaml

from agentops_common import load_yaml, load_json, sha256_text, utc_now_iso, agent_from_change_id

DEFAULT_ROOT = Path(__file__).resolve().parents[1]
PERMISSION_RANK = {"write": 1, "maintain": 2, "admin": 3}


def load_change(root: Path, change_id: str) -> tuple[dict[str, Any], str]:
    change_dir = root / "changes" / change_id
    proposal_path = change_dir / "proposal.yaml"
    diff_path = change_dir / "diff.patch"
    if not proposal_path.exists():
        raise RuntimeError(f"missing proposal: {proposal_path.relative_to(root)}")
    if not diff_path.exists():
        raise RuntimeError(f"missing diff: {diff_path.relative_to(root)}")
    proposal = load_yaml(proposal_path)
    if not isinstance(proposal, dict):
        raise RuntimeError("proposal must be a mapping")
    diff_text = diff_path.read_text(encoding="utf-8")
    diff_sha256 = sha256_text(diff_text)
    if proposal.get("change_id") != change_id:
        raise RuntimeError("proposal change_id mismatch")
    if proposal.get("diff_sha256") != diff_sha256:
        raise RuntimeError("proposal diff_sha256 mismatch")
    expected_agent = agent_from_change_id(change_id)
    if expected_agent and proposal.get("agent") != expected_agent:
        raise RuntimeError("proposal agent does not match change_id")
    return proposal, diff_sha256


def load_approvals(root: Path, change_id: str, diff_sha256: str) -> tuple[list[dict[str, Any]], bool]:
    approvals_dir = root / "changes" / change_id / "approvals"
    if not approvals_dir.exists():
        return [], False
    approvals: list[dict[str, Any]] = []
    rejections_present = False
    seen_approvers: set[str] = set()
    for approval_path in sorted(approvals_dir.glob("*.yaml")):
        approval = load_yaml(approval_path)
        if not isinstance(approval, dict):
            raise RuntimeError(f"approval must be a mapping: {approval_path.relative_to(root)}")
        if approval.get("change_id") != change_id:
            raise RuntimeError(f"approval change_id mismatch: {approval_path.relative_to(root)}")
        if approval.get("diff_sha256") != diff_sha256:
            raise RuntimeError(f"approval diff_sha256 mismatch: {approval_path.relative_to(root)}")
        decision = approval.get("decision")
        approver = approval.get("approver")
        if decision == "reject":
            rejections_present = True
            continue
        if decision != "approve":
            raise RuntimeError(f"unsupported approval decision {decision!r}: {approval_path.relative_to(root)}")
        if not isinstance(approver, str) or not approver:
            raise RuntimeError(f"approval approver is missing: {approval_path.relative_to(root)}")
        if approver in seen_approvers:
            raise RuntimeError(f"duplicate approval approver {approver!r}")
        seen_approvers.add(approver)
        approvals.append(approval)
    return approvals, rejections_present


def build_fixture_evidence(root: Path, args: argparse.Namespace) -> dict[str, Any]:
    proposal, diff_sha256 = load_change(root, args.change_id)
    approvals, rejections_present = load_approvals(root, args.change_id, diff_sha256)
    required_approvals = int(proposal.get("required_approvals") or 1)
    if rejections_present:
        raise RuntimeError("rejections are present; authenticated approval verification fails closed")
    if len(approvals) < required_approvals:
        raise RuntimeError(f"approval threshold unmet: {len(approvals)} approvals, require {required_approvals}")

    verified_at = args.verified_at or utc_now_iso()
    verified_approvals: list[dict[str, Any]] = []
    for approval in approvals:
        approver = str(approval["approver"])
        verified_approvals.append(
            {
                "approver": approver,
                "decision": "approve",
                "approved_at": approval.get("created_at"),
                "identity_provider": "github",
                "identity_subject": approver,
                "permission": args.fixture_permission,
                "evidence_kind": "pull_request_review",
                "evidence_ref": args.fixture_evidence_ref,
                "diff_sha256": diff_sha256,
                "verified": True,
            }
        )

    return build_authenticated_approval_evidence(
        args=args,
        proposal=proposal,
        diff_sha256=diff_sha256,
        verified_approvals=verified_approvals,
        verified_by="fixture-contract-only",
        verifier_mode="fixture_contract_only",
        provider="github",
    )


def canonical_json_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def load_trusted_signers(root: Path, trust_roots_path: str | None) -> dict[str, dict[str, Any]]:
    path = Path(trust_roots_path) if trust_roots_path else root / "policies" / "trusted-approval-signers.yaml"
    if not path.is_absolute():
        path = root / path
    if not path.exists():
        raise RuntimeError(f"missing trusted signer policy: {path.relative_to(root)}")
    document = load_yaml(path)
    if not isinstance(document, dict):
        raise RuntimeError("trusted signer policy must be a mapping")
    schema = load_json(root / "schemas" / "trusted-approval-signers.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    schema_errors = []
    for error in sorted(validator.iter_errors(document), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        schema_errors.append(f"{path}: {location}: {error.message}")
    if schema_errors:
        raise RuntimeError("; ".join(schema_errors))
    signers = document.get("trusted_signers")
    if not isinstance(signers, list) or not signers:
        raise RuntimeError("trusted signer policy must contain trusted_signers")
    by_key_id: dict[str, dict[str, Any]] = {}
    for index, signer in enumerate(signers):
        if not isinstance(signer, dict):
            raise RuntimeError(f"trusted_signers[{index}] must be a mapping")
        key_id = signer.get("key_id")
        if not isinstance(key_id, str) or not key_id:
            raise RuntimeError(f"trusted_signers[{index}].key_id is required")
        if key_id in by_key_id:
            raise RuntimeError(f"duplicate trusted signer key_id {key_id!r}")
        by_key_id[key_id] = signer
    return by_key_id


def load_attestation(path: Path) -> dict[str, Any]:
    attestation = load_yaml(path)
    if not isinstance(attestation, dict):
        raise RuntimeError(f"attestation must be a mapping: {path}")
    return attestation


def parse_datetime(value: Any, label: str) -> datetime:
    if not isinstance(value, str):
        raise RuntimeError(f"{label} must be a date-time string")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise RuntimeError(f"{label} must be a valid date-time") from exc
    if parsed.tzinfo is None:
        raise RuntimeError(f"{label} must include timezone")
    return parsed


def validate_attestation_schema(root: Path, attestation: dict[str, Any], path: Path) -> None:
    schema = load_json(root / "schemas" / "signed-approval-attestation.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    errors = []
    for error in sorted(validator.iter_errors(attestation), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{path}: {location}: {error.message}")
    if errors:
        raise RuntimeError("; ".join(errors))


def verify_ed25519_signature(payload: dict[str, Any], signature_b64: str, public_key_b64: str) -> None:
    try:
        from cryptography.exceptions import InvalidSignature
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    except Exception as exc:  # pragma: no cover - exercised only when dependency is absent
        raise RuntimeError("signed_attestation mode requires the cryptography package") from exc
    try:
        signature = base64.b64decode(signature_b64, validate=True)
        public_key_bytes = base64.b64decode(public_key_b64, validate=True)
        public_key = Ed25519PublicKey.from_public_bytes(public_key_bytes)
        public_key.verify(signature, canonical_json_bytes(payload))
    except InvalidSignature as exc:
        raise RuntimeError("attestation signature verification failed") from exc
    except Exception as exc:
        raise RuntimeError("attestation signature or public key is malformed") from exc


def validate_attestation_payload(
    *,
    payload: dict[str, Any],
    trusted_signer: dict[str, Any],
    proposal: dict[str, Any],
    diff_sha256: str,
    args: argparse.Namespace,
    attestation_path: Path,
) -> None:
    if payload.get("change_id") != args.change_id:
        raise RuntimeError(f"{attestation_path}: payload change_id mismatch")
    expected_agent = agent_from_change_id(args.change_id)
    if expected_agent and payload.get("agent") != expected_agent:
        raise RuntimeError(f"{attestation_path}: payload agent does not match change_id")
    if payload.get("agent") != proposal.get("agent"):
        raise RuntimeError(f"{attestation_path}: payload agent does not match proposal")
    if payload.get("diff_sha256") != diff_sha256:
        raise RuntimeError(f"{attestation_path}: payload diff_sha256 mismatch")
    repository = payload.get("repository")
    if not isinstance(repository, dict):
        raise RuntimeError(f"{attestation_path}: payload repository must be a mapping")
    if repository.get("full_name") != args.repository:
        raise RuntimeError(f"{attestation_path}: payload repository full_name mismatch")
    if repository.get("default_branch") != args.default_branch:
        raise RuntimeError(f"{attestation_path}: payload default_branch mismatch")
    signer_key_id = payload.get("signer_key_id")
    if signer_key_id != trusted_signer.get("key_id"):
        raise RuntimeError(f"{attestation_path}: signer_key_id does not match trusted signer")
    if payload.get("approver") != trusted_signer.get("approver"):
        raise RuntimeError(f"{attestation_path}: approver does not match trusted signer")
    if payload.get("identity_subject") != trusted_signer.get("identity_subject"):
        raise RuntimeError(f"{attestation_path}: identity_subject does not match trusted signer")
    if payload.get("identity_provider") != "signed_attestation":
        raise RuntimeError(f"{attestation_path}: identity_provider must be signed_attestation")
    parse_datetime(payload.get("signed_at"), "payload.signed_at")


def build_signed_attestation_evidence(root: Path, args: argparse.Namespace) -> dict[str, Any]:
    proposal, diff_sha256 = load_change(root, args.change_id)
    if not args.attestation:
        raise RuntimeError("--attestation is required for signed_attestation mode")
    trusted_signers = load_trusted_signers(root, args.trusted_signers)

    required_approvals = int(proposal.get("required_approvals") or 1)
    verified_approvals: list[dict[str, Any]] = []
    seen_approvers: set[str] = set()
    rejections_present = False

    for raw_path in args.attestation:
        path = Path(raw_path)
        if not path.is_absolute():
            path = root / path
        attestation = load_attestation(path)
        validate_attestation_schema(root, attestation, path)
        payload = attestation["payload"]
        signature = attestation["signature"]
        signer_key_id = payload["signer_key_id"]
        trusted_signer = trusted_signers.get(signer_key_id)
        if trusted_signer is None:
            raise RuntimeError(f"{path}: signer_key_id {signer_key_id!r} is not trusted")
        public_key = trusted_signer.get("public_key") if isinstance(trusted_signer.get("public_key"), dict) else {}
        if public_key.get("algorithm") != "ed25519" or public_key.get("encoding") != "raw_base64":
            raise RuntimeError(f"{path}: trusted signer public key must be ed25519 raw_base64")
        validate_attestation_payload(
            payload=payload,
            trusted_signer=trusted_signer,
            proposal=proposal,
            diff_sha256=diff_sha256,
            args=args,
            attestation_path=path,
        )
        verify_ed25519_signature(payload, signature["value"], public_key["value"])

        decision = payload["decision"]
        approver = payload["approver"]
        if decision == "reject":
            rejections_present = True
            continue
        if approver in seen_approvers:
            raise RuntimeError(f"duplicate signed approval approver {approver!r}")
        seen_approvers.add(approver)
        permission = trusted_signer.get("permission")
        if permission not in PERMISSION_RANK:
            raise RuntimeError(f"{path}: trusted signer permission is invalid")
        if PERMISSION_RANK[str(permission)] < PERMISSION_RANK[args.minimum_permission]:
            raise RuntimeError(f"{path}: trusted signer permission {permission!r} is below required {args.minimum_permission!r}")
        verified_approvals.append(
            {
                "approver": approver,
                "decision": "approve",
                "approved_at": payload["signed_at"],
                "identity_provider": "signed_attestation",
                "identity_subject": payload["identity_subject"],
                "permission": permission,
                "evidence_kind": "signed_attestation",
                "evidence_ref": payload.get("evidence_ref"),
                "diff_sha256": diff_sha256,
                "verified": True,
            }
        )

    if rejections_present:
        raise RuntimeError("signed rejection attestation is present; authenticated approval verification fails closed")
    if len(verified_approvals) < required_approvals:
        raise RuntimeError(f"signed approval threshold unmet: {len(verified_approvals)} approvals, require {required_approvals}")

    return build_authenticated_approval_evidence(
        args=args,
        proposal=proposal,
        diff_sha256=diff_sha256,
        verified_approvals=verified_approvals,
        verified_by="signed-attestation-verifier",
        verifier_mode="signed_attestation",
        provider="signed_attestation",
    )


def build_authenticated_approval_evidence(
    *,
    args: argparse.Namespace,
    proposal: dict[str, Any],
    diff_sha256: str,
    verified_approvals: list[dict[str, Any]],
    verified_by: str,
    verifier_mode: str,
    provider: str,
) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "authenticated_approval_id": f"{args.change_id}_authenticated_approval",
        "change_id": args.change_id,
        "agent": proposal.get("agent"),
        "repository": {
            "provider": provider,
            "full_name": args.repository,
            "default_branch": args.default_branch,
        },
        "diff_sha256": diff_sha256,
        "required_approvals": int(proposal.get("required_approvals") or 1),
        "verified_approvals": verified_approvals,
        "rejections_present": False,
        "verified_at": args.verified_at or utc_now_iso(),
        "verified_by": verified_by,
        "verifier_mode": verifier_mode,
        "mutation_enabled": False,
        "apply_authorized": False,
        "status": "verified_not_authorized",
        "assertions": {
            "repository_bound": True,
            "change_id_bound": True,
            "diff_hash_bound": True,
            "approval_threshold_met": True,
            "no_rejections_present": True,
            "all_approvals_verified": True,
            "does_not_authorize_apply": True,
            "does_not_mutate_profiles_or_runtime": True,
            "does_not_read_secret_values": True,
            "business_orchestration_not_authorized": True,
        },
    }


def validate_evidence(root: Path, evidence: dict[str, Any]) -> list[str]:
    schema = load_json(root / "schemas" / "authenticated-approval.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    errors: list[str] = []
    for error in sorted(validator.iter_errors(evidence), key=lambda item: list(item.path)):
        location = ".".join(str(part) for part in error.path) or "<root>"
        errors.append(f"{location}: {error.message}")
    return errors


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="verify-authenticated-approval")
    parser.add_argument("change_id")
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    parser.add_argument("--mode", choices=["fixture_contract_only", "live_github", "signed_attestation"], default="fixture_contract_only")
    parser.add_argument("--repository", default="ray-toaru/hermes-agents")
    parser.add_argument("--default-branch", default="main")
    parser.add_argument("--verified-at")
    parser.add_argument("--fixture-permission", choices=["write", "maintain", "admin"], default="write")
    parser.add_argument("--fixture-evidence-ref", default="fixture://local-approval-records")
    parser.add_argument("--trusted-signers", help="trusted signer policy for signed_attestation mode")
    parser.add_argument("--attestation", action="append", help="signed approval attestation path; repeat for multiple approvals")
    parser.add_argument("--minimum-permission", choices=["write", "maintain", "admin"], default="write")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    if args.mode == "live_github":
        print("authenticated approval verifier mode 'live_github' is not implemented; failing closed", file=sys.stderr)
        return 2
    try:
        if args.mode == "signed_attestation":
            evidence = build_signed_attestation_evidence(root, args)
        else:
            evidence = build_fixture_evidence(root, args)
        errors = validate_evidence(root, evidence)
    except Exception as exc:
        print(f"authenticated approval verification failed: {exc}", file=sys.stderr)
        return 2
    if errors:
        print("authenticated approval evidence validation failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 2
    print(yaml.safe_dump(evidence, sort_keys=False), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
