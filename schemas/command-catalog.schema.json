{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/command-catalog.schema.json",
  "title": "Hermes AgentOps Command Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "status", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "catalog_id": {"type": "string", "const": "command_catalog/v1"},
    "status": {"type": "string", "const": "catalog_only"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "owner", "risk", "run_allowed", "dispatch_allowed"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "purpose": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "run_allowed": {"type": "boolean", "const": false},
          "dispatch_allowed": {"type": "boolean", "const": false}
        }
      }
    }
  }
}
