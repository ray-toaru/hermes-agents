{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-agentops/schemas/pre-apply-plan.schema.json",
  "title": "Hermes AgentOps Pre-Apply Plan",
  "description": "A non-mutating safety contract for a future apply implementation. This schema does not enable apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "change_id",
    "agent",
    "generated_at",
    "mutation_enabled",
    "base_commit",
    "proposal_diff_sha256",
    "gates",
    "lock",
    "rollback",
    "post_apply_validation",
    "audit",
    "failure_recovery"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "plan_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}_preapply$"},
    "change_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}$"},
    "agent": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mutation_enabled": {"type": "boolean", "const": false},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "proposal_diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_valid",
        "proposal_valid",
        "approvals_valid",
        "diff_hash_valid",
        "path_scope_valid",
        "git_clean_required",
        "patch_applicable_required",
        "manual_operator_confirmation_required"
      ],
      "properties": {
        "policy_valid": {"type": "boolean", "const": true},
        "proposal_valid": {"type": "boolean", "const": true},
        "approvals_valid": {"type": "boolean", "const": true},
        "diff_hash_valid": {"type": "boolean", "const": true},
        "path_scope_valid": {"type": "boolean", "const": true},
        "git_clean_required": {"type": "boolean", "const": true},
        "patch_applicable_required": {"type": "boolean", "const": true},
        "manual_operator_confirmation_required": {"type": "boolean", "const": true}
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "scope", "mode", "stale_after_seconds", "note"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "scope": {"type": "string", "enum": ["repository"]},
        "mode": {"type": "string", "enum": ["exclusive"]},
        "stale_after_seconds": {"type": "integer", "minimum": 60},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "strategy", "pre_apply_commit_required", "note"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "strategy": {"type": "string", "enum": ["git_first"]},
        "pre_apply_commit_required": {"type": "boolean", "const": true},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "post_apply_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "commands"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "record_path", "include_stdout_stderr", "include_exit_codes", "include_git_head_before_after"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "record_path": {"type": "string", "pattern": "^changes/[0-9]{8}T[0-9]{6}Z_[a-z][a-z0-9-]{1,62}_[a-f0-9]{10}/pre-apply-plan.yaml$"},
        "include_stdout_stderr": {"type": "boolean", "const": true},
        "include_exit_codes": {"type": "boolean", "const": true},
        "include_git_head_before_after": {"type": "boolean", "const": true}
      }
    },
    "failure_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abort_on_first_failure", "rollback_on_partial_mutation", "leave_lock_for_manual_recovery", "note"],
      "properties": {
        "abort_on_first_failure": {"type": "boolean", "const": true},
        "rollback_on_partial_mutation": {"type": "boolean", "const": true},
        "leave_lock_for_manual_recovery": {"type": "boolean", "const": true},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
