#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Any

import jsonschema

from agentops_common import is_safe_relative_path, load_json, load_yaml, run_command, sha256_file

DEFAULT_ROOT = Path(__file__).resolve().parents[1]


def schema_errors(root: Path, data: dict[str, Any]) -> list[str]:
    schema = load_json(root / "schemas" / "production-lock-skeleton-run.schema.json")
    jsonschema.Draft202012Validator.check_schema(schema)
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    return [
        f"{'.'.join(str(part) for part in error.path) or '<root>'}: {error.message}"
        for error in sorted(validator.iter_errors(data), key=lambda item: list(item.path))
    ]


def validate_contract(root: Path, data: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    contract = data["contract"]
    contract_rel = contract["path"]
    if not is_safe_relative_path(contract_rel):
        return [f"contract.path must be a safe repository-relative path: {contract_rel}"]
    contract_path = root / contract_rel
    if not contract_path.exists():
        errors.append(f"contract.path does not exist: {contract_rel}")
        return errors
    actual_hash = sha256_file(contract_path)
    if contract["sha256"] != actual_hash:
        errors.append(f"contract.sha256 mismatch: expected {actual_hash}, got {contract['sha256']}")
    process = run_command([sys.executable, "scripts/check-production-apply-lock-lifecycle", contract_rel], root)
    if process.returncode != 0:
        errors.append("referenced production lock lifecycle contract is invalid")
    if contract.get("lock_release_implemented") is not False:
        errors.append("contract.lock_release_implemented must remain false")
    return errors


def validate_apply_disabled(root: Path) -> list[str]:
    process = run_command([sys.executable, "scripts/hermes-agentops", "apply", "probe"], root)
    if process.returncode == 0 or "not implemented" not in (process.stdout + process.stderr):
        return ["hermes-agentops apply must remain disabled and return non-zero"]
    return []


def semantic_errors(data: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    false_fields = [
        "mutation_enabled",
        "apply_authorized",
        "lock_acquired",
        "lock_released",
        "production_lock_written",
        "release_attempted",
        "profile_mutated",
    ]
    for field in false_fields:
        if data.get(field) is not False:
            errors.append(f"{field} must be false")
    if data["decision"].get("would_write_lock") is not False:
        errors.append("decision.would_write_lock must be false")
    if data["requested_transition"].get("executed") is not False:
        errors.append("requested_transition.executed must be false")
    for field, value in data["boundaries"].items():
        if value is not True:
            errors.append(f"boundaries.{field} must be true")
    errors.extend(consistency_errors(data))
    return errors


def consistency_errors(data: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    action = data["action"]
    status = data["status"]
    current_state = data["current_state"]
    transition = data["requested_transition"]
    decision = data["decision"]
    if transition.get("from") != current_state:
        errors.append("requested_transition.from must match current_state")
    expected_to = "acquired" if action == "acquire" else "preserved_for_review"
    if transition.get("to") != expected_to:
        errors.append(f"requested_transition.to must be {expected_to} for action {action}")
    if action == "acquire" and status == "would_acquire_not_executed":
        if current_state != "not_acquired":
            errors.append("acquire evidence must start from not_acquired")
        if decision.get("would_preserve_lock") is not False:
            errors.append("acquire evidence must not preserve a lock")
        if decision.get("manual_review_required") is not False:
            errors.append("acquire evidence must not require manual recovery review")
        if decision.get("next_allowed_step") != "review_evidence_only":
            errors.append("acquire evidence next_allowed_step must be review_evidence_only")
    elif action == "preserve" and status == "would_preserve_not_released":
        if current_state not in {"recovery_required", "preserved_for_review"}:
            errors.append("preserve evidence must start from a review-preserved state")
        if decision.get("would_preserve_lock") is not True:
            errors.append("preserve evidence must record would_preserve_lock true")
        if decision.get("manual_review_required") is not True:
            errors.append("preserve evidence must require manual review")
        if decision.get("next_allowed_step") != "manual_recovery_review":
            errors.append("preserve evidence next_allowed_step must be manual_recovery_review")
    elif status == "failed_closed":
        if decision.get("manual_review_required") is not True:
            errors.append("failed_closed evidence must require manual review")
        if decision.get("next_allowed_step") != "fix_contract_or_inputs":
            errors.append("failed_closed evidence next_allowed_step must be fix_contract_or_inputs")
    else:
        errors.append(f"status {status!r} is inconsistent with action {action!r}")
    return errors


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="check-production-lock-skeleton-run")
    parser.add_argument("path", nargs="?", default="docs/examples/production-lock-skeleton-run.yaml")
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    path = Path(args.path)
    path = path if path.is_absolute() else root / path
    try:
        data = load_yaml(path)
    except Exception as exc:
        print(f"failed to load {path}: {exc}")
        return 1
    errors = schema_errors(root, data)
    if not errors:
        errors.extend(validate_contract(root, data))
        errors.extend(validate_apply_disabled(root))
        errors.extend(semantic_errors(data))
    if errors:
        for error in errors:
            print(error)
        return 1
    print(f"production lock skeleton run valid: {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
